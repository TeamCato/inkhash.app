# Settings for the inkhash server, read on every start: sudo systemctl restart inkhash
# install.sh copies this file to /etc/inkhash/env once and never overwrites it. See docs/DEPLOY.md.

# 127.0.0.1: only this machine, and a proxy on it. 0.0.0.0: devices in the home network too, plain HTTP.
INKHASH_HOST=127.0.0.1
INKHASH_PORT=8787

# Proxies whose X-Forwarded-For names the client, e.g. Caddy or tailscale serve on this machine. See ADR 0038.
#INKHASH_TRUSTED_PROXIES=127.0.0.1,::1
