# Copy to .env next to compose.yaml. See docs/DEPLOY.md.

# A pinned version updates only when you change it, e.g. 0.1 or 0.1.0.
INKHASH_VERSION=latest

# 127.0.0.1: only this machine and a proxy on it. 0.0.0.0: devices in the home network too, plain HTTP.
INKHASH_BIND=127.0.0.1

# Only with --profile caddy: the public name. Caddy fetches the certificate.
INKHASH_DOMAIN=
