# Copy to .env next to compose.yaml. See docs/DEPLOY.md.

# A pinned version updates only when you change it, e.g. 0.1 or 0.1.0.
INKHASH_VERSION=latest

# 127.0.0.1: only this machine and a proxy on it. 0.0.0.0: devices in the home network too, plain HTTP.
INKHASH_BIND=127.0.0.1

# Only behind a reverse proxy: addresses or networks whose X-Forwarded-For names the client, comma-separated.
# 172.31.87.1 is the host as the container sees it, so a proxy on the host needs no change.
# Proxy elsewhere: put in the address the server names in its log ("... sends X-Forwarded-For but is not in ...").
INKHASH_TRUSTED_PROXIES=172.31.87.1
